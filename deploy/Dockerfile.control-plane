FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /control-plane ./cmd/control-plane

FROM alpine:3.20
RUN apk add --no-cache ca-certificates iproute2 iptables nftables

WORKDIR /app
COPY --from=builder /control-plane /app/control-plane

EXPOSE 8080
ENTRYPOINT ["/app/control-plane"]
